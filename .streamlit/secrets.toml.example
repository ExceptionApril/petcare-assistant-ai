# Petlio — Streamlit Cloud Secrets template.
# On Streamlit Cloud: Dashboard → App → Settings → Secrets → paste the body of this file
# (with real values) verbatim. On local dev, prefer .env.

# Required — get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY = "sk-or-v1-REPLACE_ME"
OPENROUTER_BASE_URL = "https://openrouter.ai/api/v1"
# gpt-oss-120b:free is currently the most reliable free model on OpenRouter and
# produces clean markdown tables. Alternatives (subject to daily quota):
#   meta-llama/llama-3.3-70b-instruct:free, openai/gpt-oss-20b:free
OPENROUTER_MODEL = "openai/gpt-oss-120b:free"

# Optional — Langfuse observability. Sign up at https://cloud.langfuse.com
LANGFUSE_SECRET_KEY = "sk-lf-REPLACE_ME"
LANGFUSE_PUBLIC_KEY = "pk-lf-REPLACE_ME"
LANGFUSE_BASE_URL = "https://cloud.langfuse.com"

# RAG store — the committed chroma_db/ directory is loaded automatically
CHROMA_DB_PATH = "./chroma_db"
RAG_TOP_K = "3"

# Security
MAX_INPUT_CHARS = "4000"
RATE_LIMIT_PER_MINUTE = "20"
